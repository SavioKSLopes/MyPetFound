# Django
DJANGO_SECRET_KEY=troque-esta-chave-em-desenvolvimento
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=pet_encontrado
POSTGRES_USER=pet_encontrado_user
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL pública/local do frontend usada nos links de recuperação de senha.
FRONTEND_URL=http://localhost:5173

# Sem EMAIL_HOST, o Django usa ConsoleEmailBackend e imprime e-mails no log.
# Para SMTP real, preencha as variáveis abaixo no arquivo .env local.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=nao-responda@mypetfound.local
